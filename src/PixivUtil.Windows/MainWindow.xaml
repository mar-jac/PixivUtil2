<Window
    x:Class="PixivUtil.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PixivUtil.Windows.Models"
    xmlns:vm="using:PixivUtil.Windows.ViewModels">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.DataContext>
            <vm:MainViewModel />
        </Grid.DataContext>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="PixivUtil Windows" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Followed previews, account history, downloads, and backend health in one native workspace." Opacity="0.72" />
            </StackPanel>
            <ProgressRing Grid.Column="1" Width="32" Height="32" IsActive="{Binding IsBusy}" />

            <InfoBar
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                IsOpen="True"
                Severity="Informational"
                Message="{Binding Status}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <ScrollViewer>
                <StackPanel Spacing="14">
                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Gallery" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Preview" Command="{Binding LoadGalleryFeedCommand}" CommandParameter="Preview" />
                                <Button Grid.Column="1" Content="New" Command="{Binding LoadGalleryFeedCommand}" CommandParameter="New" />
                                <Button Grid.Column="2" Content="Followed" Command="{Binding LoadGalleryFeedCommand}" CommandParameter="Followed" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Trending" Command="{Binding LoadTrendingCommand}" />
                                <Button Grid.Column="1" Content="Popular" Command="{Binding LoadPopularCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Artists in this view" FontSize="18" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearSelectedArtistCommand}" />
                            </Grid>
                            <ListView
                                MaxHeight="250"
                                ItemsSource="{Binding FollowedArtists}"
                                SelectedItem="{Binding SelectedArtist, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WorkCountDisplay}" FontSize="12" Opacity="0.64" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Open selected artist" Command="{Binding OpenSelectedArtistCommand}" />
                            <Button Content="Download selected artist" Command="{Binding DownloadSelectedArtistCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Account" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="OK" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AccountStatus}" Opacity="0.8" />
                            <TextBox
                                Header="PHPSESSID cookie"
                                PlaceholderText="Paste PHPSESSID when you want to save it"
                                Text="{Binding PixivCookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Save cookie" Command="{Binding SaveCookieCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Filters and automation" FontSize="18" FontWeight="SemiBold" />
                            <ComboBox
                                Header="Content type"
                                ItemsSource="{Binding ContentTypeFilters}"
                                SelectedItem="{Binding ContentTypeFilter, Mode=TwoWay}" />
                            <ToggleSwitch Header="Show R-18 previews" IsOn="{Binding ShowR18, Mode=TwoWay}" />
                            <ToggleSwitch Header="Auto-download after refresh" IsOn="{Binding AutoDownloadNew, Mode=TwoWay}" />
                            <NumberBox Header="Start page" Minimum="1" Value="{Binding StartPage, Mode=TwoWay}" />
                            <NumberBox Header="End page (0 = all)" Minimum="0" Value="{Binding EndPage, Mode=TwoWay}" />
                            <NumberBox Header="Bookmark limit (-1 = off)" Minimum="-1" Value="{Binding BookmarkCountLimit, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Backend" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BackendStatus}" />
                            <TextBlock Text="Database" FontWeight="SemiBold" Opacity="0.72" />
                            <TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" Opacity="0.72" />
                            <TextBlock Text="Download root" FontWeight="SemiBold" Opacity="0.72" />
                            <TextBlock Text="{Binding DownloadRoot}" TextWrapping="Wrap" Opacity="0.72" />
                            <Button Content="Open download root" Command="{Binding OpenDownloadRootCommand}" />
                            <Button Content="Open database folder" Command="{Binding OpenDatabaseFolderCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Download selected" Command="{Binding DownloadSelectedPreviewCommand}" />
                        <Button Grid.Column="1" Content="Open in browser" Command="{Binding OpenSelectedPreviewCommand}" />
                        <Button Grid.Column="2" Content="Filter" Command="{Binding LoadGalleryFeedCommand}" CommandParameter="{Binding GalleryFeed}" />
                        <TextBox
                            Grid.Column="3"
                            PlaceholderText="Search history, artist, artwork ID, or file path"
                            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="4" Content="Refresh all" Command="{Binding RefreshWorkspaceCommand}" />
                        <Button Grid.Column="5" Content="Preview followed" Command="{Binding PreviewNewFollowedCommand}" />
                        <Button Grid.Column="6" Content="Download new" Command="{Binding DownloadNewFollowedCommand}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GalleryTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding GalleryStatusLine}" Opacity="0.64" VerticalAlignment="Center" />
                    </Grid>
                    <GridView
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        ItemsSource="{Binding NewFollowedPreviews}"
                        SelectedItem="{Binding SelectedPreview, Mode=TwoWay}"
                        SelectionMode="Single">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220" Padding="10" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <Border Height="132" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                        <TextBlock Text="{Binding ArtistName}" Opacity="0.72" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.64" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Account history" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Refresh history" Command="{Binding RefreshHistoryCommand}" />
                    <Button Grid.Column="2" Content="Export CSV" Command="{Binding ExportHistoryCsvCommand}" />
                    <Button Grid.Column="3" Content="Open selected" Command="{Binding OpenSelectedHistoryCommand}" />
                </Grid>

                <ListView
                    Grid.Row="3"
                    ItemsSource="{Binding VisibleHistory}"
                    SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="1" />
                                    <TextBlock Text="{Binding LocalPath}" Opacity="0.64" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Id}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding LastUpdatedDisplay}" Opacity="0.64" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="14">
                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Inspector" FontSize="20" FontWeight="SemiBold" />
                            <Border Height="190" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Image Source="{Binding SelectedPreview.ThumbnailUrl}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding SelectedPreview.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedPreview.ArtistName}" Opacity="0.72" />
                            <TextBlock Text="{Binding SelectedPreview.Summary}" FontSize="12" Opacity="0.64" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Open Pixiv" Command="{Binding OpenSelectedPreviewCommand}" />
                                <Button Grid.Column="1" Content="Download" Command="{Binding DownloadSelectedPreviewCommand}" />
                            </Grid>
                            <Button Content="Download artist works" Command="{Binding DownloadSelectedArtistCommand}" />
                            <Button Content="Redownload selected history item" Command="{Binding RedownloadSelectedHistoryCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="All download modes" FontSize="18" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="Run" Command="{Binding DownloadSelectedModeCommand}" />
                            </Grid>
                            <ComboBox
                                Header="Feature"
                                ItemsSource="{Binding DownloadModes}"
                                SelectedItem="{Binding SelectedDownloadMode, Mode=TwoWay}"
                                DisplayMemberPath="Name" />
                            <TextBox
                                Header="Input"
                                PlaceholderText="IDs, tags, file path, or quoted arguments"
                                Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Include Pixiv Sketch" IsChecked="{Binding IncludeSketch, Mode=TwoWay}" />
                            <CheckBox Content="Wildcard tags" IsChecked="{Binding UseWildcardTags, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Download queue" FontSize="18" FontWeight="SemiBold" />
                            <ListView Grid.Row="1" MaxHeight="260" ItemsSource="{Binding DownloadJobs}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="6" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Status}" Opacity="0.72" />
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" />
                                            <TextBlock Text="{Binding StartedAtDisplay}" FontSize="12" Opacity="0.56" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBox
                                Grid.Row="2"
                                Header="Backend output"
                                Text="{Binding CommandOutput, Mode=OneWay}"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                MaxHeight="180"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Margin="0,16,0,0"
            Opacity="0.64"
            Text="Native C# services handle previews/history/queue state; the compatibility bridge keeps original PixivUtil download features available while backend ports continue." />
    </Grid>
</Window>
