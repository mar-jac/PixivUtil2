<Window
    x:Class="PixivUtil.WindowsTrial.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PixivUtil Windows Trial"
    Width="1280"
    Height="820"
    MinWidth="980"
    MinHeight="640"
    Background="#07111C">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#173456" />
            <Setter Property="Foreground" Value="#EAF3FF" />
            <Setter Property="BorderBrush" Value="#24496F" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF3FF" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#0F1E2D" />
            <Setter Property="Foreground" Value="#EAF3FF" />
            <Setter Property="BorderBrush" Value="#24496F" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock
                DockPanel.Dock="Left"
                Text="PixivUtil Windows Trial"
                FontSize="24"
                FontWeight="SemiBold" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Preview" Click="PreviewClicked" />
                <Button Content="New" Click="NewClicked" />
                <Button Content="Followed" Click="FollowedClicked" />
                <Button Content="Trending" Click="TrendingClicked" />
                <Button Content="Popular" Click="PopularClicked" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Background="#0C1824" CornerRadius="12" Padding="14" BorderBrush="#19334C" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Followed Artists" FontSize="17" FontWeight="SemiBold" />
                    <TextBox x:Name="ArtistSearch" Margin="0,10,0,8" Text="Search artists..." />
                    <ListBox x:Name="ArtistList" Height="260" Background="#09131E" Foreground="#EAF3FF" BorderBrush="#19334C" />
                    <Button Content="Open selected artist" Click="OpenSelectedArtistClicked" />
                    <Button Content="Download selected artist" Click="DownloadSelectedArtistClicked" />

                    <Separator Margin="0,16" Background="#19334C" />
                    <TextBlock Text="Filters" FontSize="17" FontWeight="SemiBold" />
                    <CheckBox x:Name="ShowR18" Content="Show R-18 content" Foreground="#EAF3FF" Margin="0,8" />
                    <ComboBox x:Name="ContentType" SelectedIndex="0" Margin="0,8">
                        <ComboBoxItem Content="All" />
                        <ComboBoxItem Content="Illust" />
                        <ComboBoxItem Content="Manga" />
                        <ComboBoxItem Content="Ugoira" />
                    </ComboBox>

                    <Separator Margin="0,16" Background="#19334C" />
                    <TextBlock Text="Backend" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="BackendStatus" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#9DB7D2" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="Download selected" Click="DownloadSelectedClicked" />
                        <Button Content="Open in browser" Click="OpenSelectedClicked" />
                        <Button Content="Download new followed" Click="DownloadNewFollowedClicked" />
                    </StackPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280" Text="Search works..." />
                </DockPanel>

                <ListBox
                    x:Name="Gallery"
                    Grid.Row="1"
                    Margin="0,12"
                    Background="#09131E"
                    BorderBrush="#19334C"
                    Foreground="#EAF3FF"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Border Grid.Row="2" Background="#0C1824" CornerRadius="12" Padding="12" BorderBrush="#19334C" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Account history / backend output" FontSize="17" FontWeight="SemiBold" />
                        <TextBox
                            x:Name="Output"
                            Margin="0,8,0,0"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            IsReadOnly="True" />
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#0C1824" CornerRadius="12" Padding="14" BorderBrush="#19334C" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Inspector" FontSize="20" FontWeight="SemiBold" />
                    <Border Height="180" Margin="0,12" Background="#102A44" CornerRadius="10">
                        <TextBlock Text="Artwork preview" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9DB7D2" />
                    </Border>
                    <TextBlock x:Name="SelectedTitle" Text="Select an artwork" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectedArtist" Text="No artist selected" Foreground="#9DB7D2" Margin="0,6,0,12" />
                    <Button Content="Open Pixiv" Click="OpenSelectedClicked" />
                    <Button Content="Download artwork" Click="DownloadSelectedClicked" />
                    <Button Content="Redownload selected" Click="DownloadSelectedClicked" />

                    <Separator Margin="0,16" Background="#19334C" />
                    <TextBlock Text="Download queue" FontSize="17" FontWeight="SemiBold" />
                    <ListBox x:Name="Queue" Height="170" Background="#09131E" Foreground="#EAF3FF" BorderBrush="#19334C" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            x:Name="Status"
            Grid.Row="2"
            Margin="0,12,0,0"
            Foreground="#9DB7D2"
            Text="Ready" />
    </Grid>
</Window>
