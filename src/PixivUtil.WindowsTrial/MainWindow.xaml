<Window
    x:Class="PixivUtil.WindowsTrial.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PixivUtil Windows Trial"
    Width="1320"
    Height="860"
    MinWidth="980"
    MinHeight="640"
    Background="#07111C">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#153354" />
            <Setter Property="Foreground" Value="#EAF3FF" />
            <Setter Property="BorderBrush" Value="#24496F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF3FF" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#0F1E2D" />
            <Setter Property="Foreground" Value="#EAF3FF" />
            <Setter Property="BorderBrush" Value="#24496F" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#EAF3FF" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Background="#07111C" Margin="16,8,16,0">
            <TextBlock
                DockPanel.Dock="Left"
                Text="PixivUtil Windows Trial"
                FontSize="22"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Preview" Click="PreviewClicked" />
                <Button Content="New" Click="NewClicked" />
                <Button Content="Followed" Click="FollowedClicked" />
                <Button Content="Trending" Click="TrendingClicked" />
                <Button Content="Popular" Click="PopularClicked" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="14,8,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Background="#0C1824" CornerRadius="12" Padding="14" BorderBrush="#19334C" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Followed Artists" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" Text="Refresh" Foreground="#8FB7E8" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBox x:Name="ArtistSearch" Margin="0,12,0,8" Text="Search artists..." />
                    <ListBox
                        x:Name="ArtistList"
                        Height="280"
                        Background="#09131E"
                        Foreground="#EAF3FF"
                        BorderBrush="#19334C"
                        ItemsSource="{Binding Artists}"
                        SelectionChanged="ArtistSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="24" Height="24" Fill="{Binding AvatarBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding WorkCountText}" FontSize="11" Foreground="#89A8C7" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Manage Followed Artists" Click="OpenSelectedArtistClicked" Margin="0,10,0,0" />
                    <Button Content="Download selected artist" Click="DownloadSelectedArtistClicked" Margin="0,6,0,0" />

                    <Separator Margin="0,16" Background="#19334C" />
                    <TextBlock Text="Filters" FontSize="17" FontWeight="SemiBold" />
                    <CheckBox x:Name="ShowR18" Content="Show R-18 content" Foreground="#EAF3FF" Margin="0,8" />
                    <ComboBox x:Name="ContentType" SelectedIndex="0" Margin="0,8">
                        <ComboBoxItem Content="All" />
                        <ComboBoxItem Content="Illust" />
                        <ComboBoxItem Content="Manga" />
                        <ComboBoxItem Content="Ugoira" />
                    </ComboBox>

                    <Separator Margin="0,16" Background="#19334C" />
                    <TextBlock Text="Backend" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="BackendStatus" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#9DB7D2" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="Download selected" Click="DownloadSelectedClicked" />
                        <Button Content="Open in browser" Click="OpenSelectedClicked" />
                        <Button Content="Download new followed" Click="DownloadNewFollowedClicked" />
                    </StackPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280" Text="Search works..." />
                </DockPanel>

                <ListBox
                    x:Name="Gallery"
                    Grid.Row="1"
                    Margin="0,12"
                    Background="#09131E"
                    BorderBrush="#19334C"
                    Foreground="#EAF3FF"
                    ItemsSource="{Binding GalleryItems}"
                    SelectionChanged="GallerySelectionChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="174" Height="252" CornerRadius="10" Background="#0F1D2B" BorderBrush="#254B70" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="178" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Border CornerRadius="10,10,0,0" Background="{Binding ThumbnailBrush}" />
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="6,3" Background="#AA07111C" CornerRadius="6">
                                            <TextBlock Text="{Binding BookmarkText}" FontSize="11" />
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,3" Background="#AA07111C" CornerRadius="6">
                                            <TextBlock Text="{Binding PageText}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding Artist}" Foreground="#93B2CF" FontSize="12" Margin="0,3,0,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding Tags}" Foreground="#6F8EAB" FontSize="11" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="#0C1824" CornerRadius="12" Padding="12" BorderBrush="#19334C" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Account history / backend output" FontSize="17" FontWeight="SemiBold" />
                        <TextBox
                            x:Name="Output"
                            Margin="0,8,0,0"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            IsReadOnly="True" />
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#0C1824" CornerRadius="12" Padding="14" BorderBrush="#19334C" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Inspector" FontSize="20" FontWeight="SemiBold" />
                    <Border x:Name="InspectorPreview" Height="210" Margin="0,12" Background="#102A44" CornerRadius="10">
                        <TextBlock Text="Artwork preview" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D8EAFF" />
                    </Border>
                    <TextBlock x:Name="SelectedTitle" Text="Select an artwork" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectedArtist" Text="No artist selected" Foreground="#9DB7D2" Margin="0,6,0,12" />
                    <Button Content="Open Pixiv" Click="OpenSelectedClicked" />
                    <Button Content="Download artwork" Click="DownloadSelectedClicked" />
                    <Button Content="Redownload selected" Click="DownloadSelectedClicked" />

                    <Separator Margin="0,16" Background="#19334C" />
                    <TextBlock Text="Download queue" FontSize="17" FontWeight="SemiBold" />
                    <ListBox x:Name="Queue" Height="170" Background="#09131E" Foreground="#EAF3FF" BorderBrush="#19334C" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            x:Name="Status"
            Grid.Row="2"
            Margin="14,8,14,10"
            Foreground="#9DB7D2"
            Text="Ready" />
    </Grid>
</Window>
